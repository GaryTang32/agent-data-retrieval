        "requires_approval": false,
        "preconditions": []
      },
      {
        "id": "s10",
        "type": "condition",
        "text": "If the user knew the fact, check the rules again; otherwise escalate the request.",
        "span": null,
        "tool": null,
        "subprocedure_ref": null,
        "args_schema": null,
        "condition": null,
