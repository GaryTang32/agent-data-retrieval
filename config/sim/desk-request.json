        "risk": "unknown",
        "requires_approval": false,
        "preconditions": []
      },
      {
        "id": "s3",
        "type": "condition",
        "text": "If the rules allow the opening, schedule it; if they deny it, offer another time; if they escalate, ask for the missing fact.",
        "span": null,
        "tool": null,
        "subprocedure_ref": null,
        "args_schema": null,
        "condition": null,
        "next": [
          {
            "to": "s4",
            "guard": "{\"eq\":[\"outcome\",\"allow\"]}"
          },
          {
            "to": "s5",
            "guard": "{\"eq\":[\"outcome\",\"deny\"]}"
          },
          {
            "to": "s9",
            "guard": "{\"eq\":[\"outcome\",\"escalate\"]}"
          }
        ],
        "risk": "unknown",
        "requires_approval": false,
        "preconditions": []
      },
      {
        "id": "s4",
        "type": "tool_call",
        "text": "The requested time is allowed: schedule the opening at the requested time with schedule_opening.",
        "span": null,
        "tool": "schedule_opening",
        "subprocedure_ref": null,
        "args_schema": null,
        "condition": null,
