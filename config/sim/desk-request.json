        "type": "tool_call",
        "text": "Check the rules with check_rules on scheduling the requested opening: intent schedule_opening at the requested time, with the facts of the request record.",
        "span": null,
        "tool": "check_rules",
        "subprocedure_ref": null,
        "args_schema": {
          "const": {
            "intent.tool": "schedule_opening"
          }
        },
        "condition": null,
