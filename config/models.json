{
  "_comment": "Named model profiles for --generator / --judge and `adr-eval doctor`. No keys here: an API profile reads its key from the environment variable named in api_key_env. A model starting with \"<set\" is a placeholder: the profile is unconfigured until it is replaced. See docs/eval/providers.md.",
  "profiles": {
    "claude_code_sonnet": {"adapter": "claude_code", "model": "claude-sonnet-5-5"},
    "claude_code_opus": {"adapter": "claude_code", "model": "claude-opus-5-5"},
    "claude_code_haiku": {"adapter": "claude_code", "model": "claude-haiku-5-5"},
    "anthropic_sonnet": {"adapter": "anthropic", "model": "claude-sonnet-5-5",
                         "api_key_env": "ANTHROPIC_API_KEY"},
    "openai": {"adapter": "openai_compatible", "base_url": "https://api.openai.com/v1",
               "model": "<set when key arrives>", "api_key_env": "OPENAI_API_KEY",
               "family": "openai"},
    "gemini": {"adapter": "openai_compatible",
               "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
               "model": "<set when key arrives>", "api_key_env": "GEMINI_API_KEY",
               "family": "google"},
    "deepseek": {"adapter": "openai_compatible", "base_url": "https://api.deepseek.com/v1",
                 "model": "<set when key arrives>", "api_key_env": "DEEPSEEK_API_KEY",
                 "family": "deepseek"},
    "openrouter": {"adapter": "openai_compatible", "base_url": "https://openrouter.ai/api/v1",
                   "model": "<set when key arrives>", "api_key_env": "OPENROUTER_API_KEY",
                   "family": "<set to the served model's family, e.g. openai or google>"},
    "selfhost": {"adapter": "openai_compatible", "base_url": "http://localhost:8000/v1",
                 "model": "<set to the model served at base_url>",
                 "api_key_env": "SELFHOST_API_KEY", "family": "selfhost"}
  },
  "stub": {"adapter": "stub", "family": "stub",
           "note": "used by `adr-eval run --stub`: a deterministic generator and judge built from the golden set (tests and demos); not a profile for --generator / --judge"}
}
